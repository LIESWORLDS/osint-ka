# Get this from @BotFather
BOT_TOKEN=8932642969:AAGL2sGAYuf6OgB2TO5D-RRMxf4XGN7NZds

# Your bot's username WITHOUT the @ (used to build referral links)
BOT_USERNAME=your_bot_username

# Fallback force-join channel, used ONLY if no channels have been added
# yet from the /admin panel. Once you add channels via /admin, these two
# are ignored.
CHANNEL_ID=@your_channel_username
CHANNEL_LINK=https://t.me/your_channel_username

# External API used by "Get Info" to look up a 10-digit number.
# Use {number} as a placeholder — it will be replaced with the user's number.
CODE_INFO_API_URL=https://info.apikendra.cc/search/any?q={number}

# External API hit repeatedly by "Blast" for up to 5 minutes.
# Use {number} as a placeholder — it will be replaced with the user's number.
BLAST_API_URL=https://api.example.com/blast?number={number}

# Seconds between each Blast round (default 5). Lower = more API calls.
BLAST_INTERVAL_SECONDS=5

# Comma-separated Telegram user IDs to bootstrap as admins on first run.
# You can add more admins later from the /admin panel itself.
ADMIN_IDS=123456789,987654321
